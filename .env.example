# ─── Public config (VITE_ = bundled into the browser; not secret) ───────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ─── Server-only secrets (never add a VITE_ prefix to these) ────────────────
# Lets the server save orders, reviews, newsletter sign-ups and admin edits.
# Supabase → Project Settings → API Keys → secret (service_role) key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Who may open /admin: comma-separated, verified emails (Google or confirmed email sign-in).
# Leave unset to use the built-in list in src/lib/server/env.server.ts.
ADMIN_EMAILS=you@example.com

# AI bouquet finder (Lovable AI Gateway).
LOVABLE_API_KEY=
